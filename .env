# Focus Buddy Configuration
# Edit these values to switch API endpoints dynamically

# OpenAI-compatible API endpoint
# Default: NVIDIA API
# To switch to LM Studio: FOCUS_API_URL=http://100.76.124.69:1234/v1
FOCUS_API_URL=https://integrate.api.nvidia.com/v1

# API key for the endpoint
# For LM Studio, this can be anything (e.g., "not-needed")
FOCUS_API_KEY=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

# Vision model (must support image input)
# Options on NVIDIA: meta/llama-3.2-11b-vision-instruct, meta/llama-3.2-90b-vision-instruct
FOCUS_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# Reasoning model (text-only focus evaluator)
# Options on NVIDIA: qwen/qwen2.5-coder-32b-instruct, meta/llama-3.3-70b-instruct
FOCUS_REASONING_MODEL=qwen/qwen2.5-coder-32b-instruct
