# Focus Buddy Configuration
# Copy this to .env and modify to switch endpoints dynamically

# OpenAI-compatible API endpoint
FOCUS_API_URL=https://integrate.api.nvidia.com/v1

# API key for the endpoint
FOCUS_API_KEY=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

# Vision model (must support image input)
FOCUS_VISION_MODEL=qwen/qwen2.5-vl-7b-instruct

# Reasoning model (text-only focus evaluator)
FOCUS_REASONING_MODEL=deepseek-ai/deepseek-v4-pro
